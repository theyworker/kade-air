DATABASE_URL=postgres://user:pass@host/db?sslmode=require
UPSTASH_REDIS_REST_URL=https://example.upstash.io
UPSTASH_REDIS_REST_TOKEN=replace-me
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional. Tunes the rate limiters without a deploy. Defaults (40/hour create,
# 120/minute read) already account for carrier-grade NAT, where an entire
# mobile carrier's users can share one egress IP.
RATE_LIMIT_CREATE_PER_HOUR=40
RATE_LIMIT_READ_PER_MINUTE=120

# /admin (the control tower). The two usernames are hardcoded — `devaka` and
# `dinuk` — but their passwords live here, because a password committed to a
# public repository is a published password. Login is refused outright until
# both are set. Changing either one signs everybody out: the cookie signing key
# is derived from them.
ADMIN_PASSWORD_DEVAKA=replace-me
ADMIN_PASSWORD_DINUK=replace-me
